# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
supabase/.temp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local generated artifacts
/generated/
# レポート生成スクリプトのミラー出力（public/reports/ が配信用の正本。output/ は重複なので追跡しない）
/output/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare workers / wrangler local artifacts and secrets
.wrangler/
workers/**/.wrangler/
workers/**/node_modules/
workers/api/.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts

# local session / launch config (Claude Code, preview launch)
# .claude はマシンローカル設定(settings.local.json 等)なので既定は無視。
# ただし skills/ はプロジェクトスキル(監視ルーティンの手順書)なので repo で管理する。
.claude/*
!.claude/skills/
